{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pwatsonr/autonomous-dev/plugins/autonomous-dev/schemas/deploy-config-v2.json",
  "title": "Autonomous-Dev Deploy Configuration v2",
  "description": "Validates the YAML at <repo>/.autonomous-dev/deploy.yaml. Superset of v1: adds optional 'targets' array and accepts version '2.0'. v1 documents load unchanged. Cross-reference: issues #658, #659, TDD-023 §9.",
  "type": "object",
  "required": ["version", "environments"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": ["1.0", "2.0"],
      "description": "Schema version. '1.0' for legacy configs; '2.0' adds the optional 'targets' array."
    },
    "default_backend": {
      "type": "string",
      "minLength": 1,
      "description": "Backend name used when an environment does not declare its own."
    },
    "parameters": {
      "type": "object",
      "description": "Repo-level parameters merged underneath each environment's parameters (shallow merge)."
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "description": "Map of environment name to environment config.",
      "patternProperties": {
        "^(dev|staging|prod|[a-z][a-z0-9_-]{0,30})$": { "$ref": "#/$defs/environment" }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "description": "Optional array of statically-declared deploy targets (issues #658 + #659). Absent in v1 configs. Dynamic targets from plugins are NOT listed here.",
      "items": { "$ref": "#/$defs/deployTarget" },
      "default": []
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "required": ["backend", "approval", "cost_cap_usd"],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1,
          "description": "Backend name as registered in BackendRegistry."
        },
        "parameters": {
          "type": "object",
          "description": "Environment-specific parameters; overrides repo-level parameters key-by-key (shallow merge)."
        },
        "approval": {
          "enum": ["none", "single", "two-person", "admin"],
          "description": "Required approval level before the deploy phase invokes the backend."
        },
        "cost_cap_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Per-deploy daily cost cap in USD. 0 means no cap."
        },
        "auto_promote_from": {
          "type": "string",
          "description": "Optional source environment name; promotion logic is out-of-scope for PLAN-023-2."
        }
      }
    },
    "deployTarget": {
      "type": "object",
      "required": ["id", "name", "kind", "provider", "capabilities", "tags", "source"],
      "additionalProperties": true,
      "description": "A first-class deploy destination. 'kind' and 'capabilities' are open strings (invariant #674).",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Unique lowercase-kebab identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable label."
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Open string target kind (e.g., 'swarm-node', 'k3s-cluster', 'cloud-run-service')."
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Backend name that handles deployments to this target."
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Open string capability tokens (e.g., 'gpu', 'production-tier')."
        },
        "env": {
          "type": "string",
          "description": "Optional logical environment (e.g., 'prod')."
        },
        "trust": {
          "type": "string",
          "description": "Optional trust level (e.g., 'production', 'internal')."
        },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Arbitrary key/value metadata for selector matching."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Provenance: 'config', 'discovery', or plugin-specific label."
        },
        "connectionRef": {
          "description": "Optional backend-specific connection info (host, path, kubeconfig, etc.)."
        }
      }
    }
  },
  "examples": [
    {
      "version": "1.0",
      "default_backend": "static",
      "environments": {
        "dev": { "backend": "local", "parameters": {}, "approval": "none", "cost_cap_usd": 0 },
        "prod": { "backend": "static", "parameters": { "target_dir": "/var/www/prod" }, "approval": "two-person", "cost_cap_usd": 25 }
      }
    },
    {
      "version": "2.0",
      "default_backend": "local",
      "environments": {
        "dev": { "backend": "local", "approval": "none", "cost_cap_usd": 0 },
        "prod": { "backend": "docker-local", "approval": "two-person", "cost_cap_usd": 50 }
      },
      "targets": [
        {
          "id": "cloud-prod",
          "name": "Cloud Production",
          "kind": "cloud-run-service",
          "provider": "gcp-cloud-run",
          "capabilities": ["production-tier", "autoscale"],
          "env": "prod",
          "trust": "production",
          "tags": { "region": "us-central1", "tier": "prod" },
          "source": "config"
        }
      ]
    }
  ]
}
