{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-dev/schemas/events/rate_limit_backoff.schema.json",
  "title": "rate_limit_backoff event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "event_type",
    "request_id",
    "session_id",
    "class",
    "retry_at",
    "source"
  ],
  "properties": {
    "timestamp":  { "type": "string", "format": "date-time" },
    "event_type": { "const": "rate_limit_backoff" },
    "request_id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{6}$|^REQ-[0-9]{8}-[0-9a-f]{4}$"
    },
    "session_id": { "type": "string", "minLength": 1 },
    "class":      { "enum": ["session_limit"] },
    "retry_at":   { "type": "string", "format": "date-time" },
    "source":     { "enum": ["parsed", "floor"] },
    "raw_reset_text": { "type": ["string", "null"] }
  }
}
