{
  "daemon": {
    "poll_interval_seconds": 30,
    "heartbeat_interval_seconds": 30,
    "circuit_breaker_threshold": 3,
    "idle_backoff_max_seconds": 900,
    "graceful_shutdown_timeout_seconds": 300,
    "error_backoff_base_seconds": 30,
    "error_backoff_max_seconds": 900,
    "max_retries_per_phase": 3,
    "daily_cost_cap_usd": 50.00,
    "monthly_cost_cap_usd": 500.00,
    "log_max_size_mb": 50,
    "log_retention_days": 7,
    "merge_gate_non_blocking_checks": [
      "markdown",
      "lychee",
      "visual-regression",
      "scope-enforcement",
      "scope-enforcement/kind"
    ],
    "merge_gate_skip_baseline_red": false,
    "pr_comment_non_actionable_authors": [
      "[bot]",
      "github-actions",
      "dependabot",
      "renovate",
      "codecov"
    ],
    "dispatch_timeout_seconds": 1800,
    "dispatch_timeout_by_phase": {
      "intake": 600,
      "prd": 3600,
      "tdd": 3600,
      "plan": 3600,
      "spec": 5400,
      "prd_review": 1800,
      "tdd_review": 1800,
      "plan_review": 1800,
      "spec_review": 1800,
      "code_review": 1800,
      "code": 10800,
      "integration": 7200,
      "deploy": 1800,
      "monitor": 1200
    },
    "max_soft_timeout_reentries": 5,
    "max_turns_by_phase": {
      "intake": 10,
      "prd": 50,
      "tdd": 50,
      "plan": 50,
      "spec": 50,
      "prd_review": 30,
      "tdd_review": 30,
      "plan_review": 30,
      "spec_review": 30,
      "code_review": 30,
      "code": 200,
      "integration": 100,
      "deploy": 30
    }
  },
  "repositories": {
    "allowlist": []
  },
  "observability": {
    "hung_session": {
      "enabled": true,
      "heartbeat_interval_seconds": 15,
      "silent_stall_seconds": 300,
      "anomaly_multiplier": 3.0,
      "min_baseline_samples": 5,
      "baselines_max_samples_per_phase": 200,
      "lsof_max_rows": 200,
      "transcript_tail_bytes": 65536,
      "transcript_tail_lines": 128,
      "kill_on_anomaly": false
    }
  }
}
